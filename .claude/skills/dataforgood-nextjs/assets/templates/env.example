# Copiar como .env en la raíz. Docker Compose lo lee automáticamente. Cambia TODAS las claves.

# Cómo abre la app el navegador. Para probar desde un teléfono, usa la IP de tu máquina en ambas.
APP_ORIGIN=http://localhost:3000
S3_PUBLIC_ENDPOINT=http://localhost:9000
APP_PORT=3000
S3_BUCKET=dataforgood-aportes

# PostgreSQL. La contraseña va dentro de DATABASE_URL: usa solo letras, números y guiones.
POSTGRES_USER=dataforgood
POSTGRES_PASSWORD=cambia-esta-clave-postgres
POSTGRES_DB=dataforgood

# MinIO. Root solo para administración (mínimo 8 caracteres).
MINIO_ROOT_USER=minio-admin
MINIO_ROOT_PASSWORD=cambia-esta-clave-root-minio
# Usuario de la app: solo tiene acceso al bucket (lo crea minio-setup).
MINIO_APP_ACCESS_KEY=dataforgood-app
MINIO_APP_SECRET_KEY=cambia-esta-clave-app-minio
